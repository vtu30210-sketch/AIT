        "def dfs(graph, vertex, visited):\n",
        "    visited.add(vertex)\n",
        "    print(vertex, end=\" \")\n",
        "    for neighbor in graph[vertex]:\n",
        "        if neighbor not in visited:\n",
        "            dfs(graph, neighbor, visited)\n",
        "\n",
        "\n",
        "# Graph\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F'],\n",
        "    'D': [],\n",
        "    'E': [],\n",
        "    'F': []\n",
        "}\n",
        "\n",
        "visited = set()\n",
        "\n",
        "print(\"DFS Traversal:\")\n",
        "dfs(graph, 'A', visited)"
